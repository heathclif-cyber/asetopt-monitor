# Copy to .env.gis. This file is for the isolated GIS development stack only.
GIS_POSTGRES_USER=asetopt_gis
GIS_POSTGRES_PASSWORD=ubah-password-lokal-ini
GIS_POSTGRES_DB=asetopt_gis_dev
GIS_POSTGRES_PORT=55432
GIS_API_PORT=8000
ASETOPT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_SECRET=ganti-secret-lokal-minimum-32-karakter
ASETOPT_BYPASS_AUTH=true
VITE_BYPASS_AUTH=true
